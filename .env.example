# CHAI-Whisper configuration.
# Copy to .env and fill in. NEVER commit .env (it holds live secrets).
#
# The local app (src/) and the DGX server (server/) read different subsets:
#   - the LOCAL app needs the SPARK_* connection vars + CHAI_WHISPER_TOKEN
#   - the DGX SERVER needs CHAI_WHISPER_TOKEN + HF_TOKEN (put those in server/.env)

# ---- LOCAL APP: how to reach the DGX ----
# When SPARK_USERNAME + SPARK_PASSWORD + SPARK_IP are all set, the app opens its
# own SSH tunnel to the box (the API port is firewalled to loopback on the DGX).
SPARK_IP=10.74.82.14
SPARK_SSH_PORT=22
SPARK_USERNAME=chai_user
SPARK_PASSWORD=change-me
# The CHAI-Whisper API's loopback port on the DGX (matches server CHAI_WHISPER_PORT).
SPARK_PORT=8060

# Direct URL fallback, used only if the SSH vars above are NOT set.
CHAI_WHISPER_URL=http://127.0.0.1:8060

# Shared bearer secret — must be identical on the local app and the server.
CHAI_WHISPER_TOKEN=generate-a-long-random-token

# Optional local request defaults.
CHAI_WHISPER_MODEL=large-v3
CHAI_WHISPER_LANGUAGE=

# ---- DGX SERVER (put these in server/.env on the box) ----
# CHAI_WHISPER_TOKEN=<same value as above>
# HF_TOKEN=<HuggingFace token; needed for diarization — accept the pyannote terms>
# CHAI_WHISPER_PORT=8060
